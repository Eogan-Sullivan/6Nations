NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=https://your-frontend.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-at-deployment
SUPABASE_SERVICE_ROLE_KEY=replace-at-deployment
WORKER_ID=worker
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=120
WORKER_BATCH_SIZE=5
PROVIDERS_ENABLED=false
PROVIDER_ENTITLEMENTS=
PROVIDER_MONTHLY_BUDGET_CENTS=500
# Populate only after approved access, schema, identity mappings and coverage review.
SIX_NATIONS_PROVIDER_CONFIG=
SIX_NATIONS_PROVIDER_HEADERS={}
SIX_NATIONS_REQUEST_LIMIT=60
BACKEND_IMAGE=six-nations-backend:local
