{
  "name": "@six-nations/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "start": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "contracts": "tsx scripts/export-openapi.ts",
    "contracts:check": "tsx scripts/export-openapi.ts --check",
    "replay": "tsx scripts/replay-season.ts",
    "types": "openapi-typescript contracts/openapi.json --output contracts/client-types.d.ts",
    "types:check": "openapi-typescript contracts/openapi.json --output contracts/client-types.d.ts --check",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\" \"*.ts\" \"*.yaml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\" \"*.ts\" \"*.yaml\""
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.9.1",
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/supabase-js": "2.117.2",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
