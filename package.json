{
  "name": "six-nations-fantasy",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend",
    "tooling/api-types"
  ],
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=11.21.0 <12"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "chokidar": { "braces": "file:./tooling/vendor/packages/braces-3.0.4+sixnations.1.tgz" },
    "micromatch": { "braces": "file:./tooling/vendor/packages/braces-3.0.4+sixnations.1.tgz" },
    "query-string": { "decode-uri-component": "file:./tooling/vendor/packages/decode-uri-component-0.5.0+sixnations.1.tgz" },
    "@expo/cli": { "@expo/code-signing-certificates": "file:./tooling/vendor/packages/expo-code-signing-certificates-0.0.6+sixnations.1.tgz" },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "dev:web": "npm run web --workspace frontend",
    "dev:frontend": "npm run start --workspace frontend",
    "verify:frontend": "npm run typecheck --workspace frontend && npm run test --workspace frontend && npm run build:web --workspace frontend",
    "build": "npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspace backend",
    "test": "npm run test --workspace backend",
    "contracts": "npm run contracts --workspace backend",
    "contracts:check": "npm run contracts:check --workspace backend",
    "test:db": "bash backend/scripts/test-database.sh",
    "types": "npm run types --workspace backend",
    "types:check": "npm run types:check --workspace backend",
    "verify": "npm run typecheck && npm test && npm run build && npm run contracts:check && npm run types:check && npm run test:tooling",
    "test:tooling": "node --test tooling/security/*.test.cjs"
  },
  "devDependencies": {
    "braces": "file:./tooling/vendor/packages/braces-3.0.4+sixnations.1.tgz",
    "decode-uri-component": "file:./tooling/vendor/packages/decode-uri-component-0.5.0+sixnations.1.tgz",
    "node-forge": "file:./tooling/vendor/packages/node-forge-1.4.1+sixnations.1.tgz",
    "@expo/code-signing-certificates": "file:./tooling/vendor/packages/expo-code-signing-certificates-0.0.6+sixnations.1.tgz"
  },
  "packageManager": "npm@11.21.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
